From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Daedalean <yocto@daedalean.ai>
Date: Thu, 12 Jun 2025 00:00:00 +0000
Subject: [PATCH] Yocto superbuild: native pymavlink for mavlink ExternalProject

Forward native Python paths through build_target into the mavlink
ExternalProject. Mavlink only generates C headers with native Python, so do
not pass the cross toolchain into its ExternalProject. Apply a patch so
mavgen uses python3-pymavlink-native instead of pip.

Upstream-Status: Inappropriate [yocto integration]

---
 cpp/third_party/cmake/build_target.cmake | 2 ++
 cpp/third_party/mavlink/CMakeLists.txt   | 7 +++++--
 2 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/cpp/third_party/cmake/build_target.cmake b/cpp/third_party/cmake/build_target.cmake
index 706fcc3f..1fa2cccf 100644
--- a/cpp/third_party/cmake/build_target.cmake
+++ b/cpp/third_party/cmake/build_target.cmake
@@ -25,6 +25,8 @@ function(build_target TARGET_NAME)
             "-DMAVLINK_DIALECT=${MAVLINK_DIALECT}"
             "-DMAVLINK_URL=${MAVLINK_URL}"
             "-DMAVLINK_HASH=${MAVLINK_HASH}"
+            "-DPYTHON_NATIVE_SITEPACKAGES=${PYTHON_NATIVE_SITEPACKAGES}"
+            "-DPython3_EXECUTABLE=${Python3_EXECUTABLE}"
             "${TARGET_SOURCE_DIR}"
         WORKING_DIRECTORY "${TARGET_BINARY_DIR}"
         RESULT_VARIABLE CONFIGURE_FAILED
diff --git a/cpp/third_party/mavlink/CMakeLists.txt b/cpp/third_party/mavlink/CMakeLists.txt
index 23f814cd..1416d6a8 100644
--- a/cpp/third_party/mavlink/CMakeLists.txt
+++ b/cpp/third_party/mavlink/CMakeLists.txt
@@ -5,8 +5,10 @@ include(ExternalProject)
 
 list(APPEND CMAKE_ARGS
     "-DCMAKE_INSTALL_PREFIX:PATH=${CMAKE_INSTALL_PREFIX}"
-    "-DCMAKE_TOOLCHAIN_FILE:PATH=${CMAKE_TOOLCHAIN_FILE}"
     "-DMAVLINK_DIALECT=${MAVLINK_DIALECT}"
+    "-DPYTHON_NATIVE_SITEPACKAGES=${PYTHON_NATIVE_SITEPACKAGES}"
+    "-DPython3_EXECUTABLE=${Python3_EXECUTABLE}"
+    "-DPython_EXECUTABLE=${Python3_EXECUTABLE}"
     )
 
 set(MAVLINK_GIT_HASH d6a7eeaf43319ce6da19a1973ca40180a4210643)
@@ -35,6 +37,7 @@ else()
         GIT_TAG "${MAVLINK_HASH}"
         PREFIX mavlink
         PATCH_COMMAND git checkout . && git apply ${PROJECT_SOURCE_DIR}/mavlink.patch
+            && git apply ${PROJECT_SOURCE_DIR}/mavlink-yocto-pymavlink.patch
         CMAKE_ARGS "${CMAKE_ARGS}"
         INSTALL_COMMAND ${CMAKE_COMMAND} --build <BINARY_DIR> --target install
                 COMMAND ${CMAKE_COMMAND} -E make_directory ${CMAKE_INSTALL_PREFIX}/include/mavlink/message_definitions/v1.0
